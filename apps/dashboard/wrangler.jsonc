{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "daffa-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  // Custom domain, not a route pattern. Cloudflare manages the DNS record.
  // link.daffa.me serves the public page at / and the dashboard at
  // /dashboard. shorten.daffa.me is retired without a redirect.
  "routes": [{ "pattern": "link.daffa.me", "custom_domain": true }],

  // Only link.daffa.me reaches this Worker. No workers.dev subdomain and no
  // preview URLs, so Cloudflare Access cannot be bypassed through another host.
  // Access protects /dashboard and /api/admin only, and the Worker verifies
  // the Access JWT on every /api/admin request itself.
  "workers_dev": false,
  "preview_urls": false,

  // The SPA is served as static assets. Only /api/* runs the Worker, every
  // other path falls back to index.html. The directory is filled in by
  // @cloudflare/vite-plugin from the client build output.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  // Daily purge of old rate limit windows and daily budget rows, at 00:15 UTC
  // (07:15 WIB), just after the public limits reset. Run it locally with
  // npm run cron:local while npm run dev is running.
  "triggers": { "crons": ["15 0 * * *"] },

  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, TURNSTILE_SECRET and RATE_LIMIT_SECRET are
  // set as secrets in production, never here. Locally, .dev.vars holds the
  // development bypass and the Turnstile test secret instead.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daffa-links",
      // Must be identical to the redirector config. Locally the D1 file name
      // is derived from this id, so both Workers share one database.
      "database_id": "c2d42ed4-b18e-438c-b1e1-997c3b5bce28",
      "migrations_dir": "../../migrations"
    }
  ]
}
