{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "daffa-redirector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Custom domain, not a route pattern. Cloudflare manages the DNS record.
  "routes": [{ "pattern": "daffa.me", "custom_domain": true }],

  // src/robots.txt is imported as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daffa-links",
      // Placeholder. Replace after creating the database manually with
      // `wrangler d1 create daffa-links`. The same id goes in the dashboard config.
      "database_id": "c2d42ed4-b18e-438c-b1e1-997c3b5bce28",
      // Migrations live at the repo root and are shared with the dashboard
      // Worker. Resolved relative to this config file.
      "migrations_dir": "../../migrations"
    }
  ]
}
