{
  "name": "daffa-url-shortener",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n redirect,dashboard -c yellow,cyan \"npm:dev:redirect\" \"npm:dev:dashboard\"",
    "dev:redirect": "wrangler dev -c apps/redirector/wrangler.jsonc --persist-to .wrangler-state --port 8787",
    "dev:dashboard": "npm run dev -w @daffa/dashboard",
    "build:dashboard": "npm run build -w @daffa/dashboard",
    "migrate:local": "wrangler d1 migrations apply daffa-links --local --persist-to .wrangler-state -c apps/redirector/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply daffa-links --remote -c apps/redirector/wrangler.jsonc",
    "deploy:redirect": "wrangler deploy -c apps/redirector/wrangler.jsonc",
    "deploy:dashboard": "npm run deploy -w @daffa/dashboard",
    "seed:local":"node scripts/seed.mjs",
    "smoke": "node scripts/api-smoke.mjs",
    "explain": "node scripts/explain.mjs",
    "db:counts": "node scripts/db-counts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard",
    "check:pages": "node scripts/check-page-size.mjs",
    "check:copy": "node scripts/audit-copy.mjs",
    "check:tokens": "node scripts/audit-tokens.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run check:pages && npm run check:copy && npm run check:tokens"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
